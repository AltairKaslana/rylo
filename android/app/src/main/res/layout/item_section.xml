<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingBottom="10dp"
        android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="20dp"
        android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFF"
        android:textSize="22sp" android:textStyle="bold"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingRight="12dp" android:clipToPadding="false"/>
</LinearLayout>
