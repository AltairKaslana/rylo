<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <EditText android:id="@+id/q" android:layout_width="match_parent"
        android:layout_height="44dp" android:layout_margin="12dp"
        android:background="@drawable/bg_search" android:hint="Cari lagu, album, artis"
        android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true"
        android:paddingLeft="16dp" android:paddingRight="16dp"
        android:textColor="#FFFFFF" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingLeft="12dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/chip0" style="@style/Chip" android:text="Lagu"/>
        <TextView android:id="@+id/chip1" style="@style/Chip" android:text="Album"/>
        <TextView android:id="@+id/chip2" style="@style/Chip" android:text="Artis"/>
        <TextView android:id="@+id/chip3" style="@style/Chip" android:text="Playlist"/>
    </LinearLayout>

    <!-- Panel pencarian terakhir: hanya terlihat saat kotak pencarian kosong -->
    <LinearLayout android:id="@+id/recentPanel" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingLeft="6dp"
            android:paddingRight="6dp" android:paddingTop="10dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/recentBack" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="← Kembali"
                android:textColor="#7FB2FF" android:textSize="12sp"
                android:padding="8dp" android:visibility="gone"/>
            <TextView android:id="@+id/recentTitle" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Pencarian terakhir" android:textColor="#FFFFFF"
                android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/recentClear" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Hapus semua"
                android:textColor="#7FB2FF" android:textSize="12sp"
                android:padding="8dp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView android:id="@+id/recentEmpty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="24dp"
            android:gravity="center" android:text="Belum ada pencarian"
            android:textColor="#8A8A8A" android:textSize="13sp"
            android:visibility="gone"/>
    </LinearLayout>

    <include layout="@layout/fragment_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
