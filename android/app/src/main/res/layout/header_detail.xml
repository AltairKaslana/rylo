<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
    <ImageView android:id="@+id/h_cover" android:layout_width="200dp" android:layout_height="200dp"
        android:scaleType="centerCrop"/>
    <TextView android:id="@+id/h_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:gravity="center" android:maxLines="2" android:ellipsize="end"
        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/h_sub" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:gravity="center" android:textColor="#AAAAAA" android:textSize="14sp"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="horizontal">
        <TextView android:id="@+id/h_play" android:layout_width="120dp" android:layout_height="44dp"
            android:background="@drawable/bg_btn_fill" android:gravity="center"
            android:text="Putar" android:textColor="#000000" android:textSize="15sp"
            android:textStyle="bold"/>
        <TextView android:id="@+id/h_shuffle" android:layout_width="120dp" android:layout_height="44dp"
            android:layout_marginLeft="12dp" android:background="@drawable/bg_btn_outline"
            android:gravity="center" android:text="Acak" android:textColor="#FFFFFF"
            android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
